{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "dom"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@pages/*":    ["./src/main/ui/pages/*"],
      "@ui/*":       ["./src/main/ui/*"],
      "@api/*":      ["./src/main/api/*"],
      "@shared/*":   ["./src/main/shared/*"],
      "@utils/*":    ["./src/main/shared/utils/*"],
      "@config/*":   ["./src/main/shared/config/*"],
      "@fixtures/*": ["./src/main/ui/fixtures/*"],
      "@test-data/*":["./test-data/*"]
    },
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test-results"
  ]
}
