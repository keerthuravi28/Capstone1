# ─────────────────────────────────────────────
# OrangeHRM Test Framework - Environment Config
# Copy this file to .env and fill in values
# ─────────────────────────────────────────────

# Application
BASE_URL=https://opensource-demo.orangehrmlive.com
APP_USERNAME=Admin
APP_PASSWORD=admin123

# API
API_BASE_URL=https://opensource-demo.orangehrmlive.com/web/index.php/api/v2
API_TIMEOUT=15000

# Browser
BROWSER=chromium
HEADLESS=false
SLOW_MO=0
TIMEOUT=30000

# Logging
LOG_LEVEL=info

# Database (generic placeholder for future implementation)
DB_ENABLED=false
DB_TYPE=generic
DB_HOST=localhost
DB_PORT=0
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=
DB_SSL=false
DB_CONNECTION_TIMEOUT_MS=10000
